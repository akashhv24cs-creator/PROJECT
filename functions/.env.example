# ============================================================
# ZENERA TRIPS — Cloud Functions Environment Configuration
# ============================================================

# Razorpay Payment Gateway credentials can be managed via
# functions/.env or Firebase Secret Manager:
#
# To set secrets in Firebase Secret Manager, run:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#
# To verify a secret is set:
#   firebase functions:secrets:access RAZORPAY_KEY_ID
#
# To list all secrets in the project:
#   firebase functions:secrets:list
#
# Secrets are bound to createRazorpayOrder and verifyRazorpayPayment
# via .runWith({ secrets: [razorpayKeyId, razorpayKeySecret] }) or defineSecret()
# and injected into process.env at function execution time.
#
# Razorpay Dashboard: https://dashboard.razorpay.com/
#
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
