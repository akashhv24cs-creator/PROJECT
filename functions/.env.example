# ============================================================
# ZENERA TRIPS — Cloud Functions Environment Configuration
# ============================================================

# Cashfree Payment Gateway credentials are managed exclusively
# via Firebase Secret Manager. Do NOT put credentials here.
#
# To set secrets, run:
#   firebase functions:secrets:set CASHFREE_APP_ID
#   firebase functions:secrets:set CASHFREE_SECRET_KEY
#
# To verify a secret is set:
#   firebase functions:secrets:access CASHFREE_APP_ID
#
# To list all secrets in the project:
#   firebase functions:secrets:list
#
# Secrets are bound to createCashfreeOrder and getPaymentStatus
# via .runWith({ secrets: [cashfreeAppId, cashfreeSecretKey] })
# and injected into process.env at function execution time.
#
# Production Cashfree dashboard: https://merchant.cashfree.com
# Production endpoint:           https://api.cashfree.com/pg
# API version:                   2025-01-01
